{
  "name": "odoo_sale_order_v1",
  "description": "Odoo standard Sale Order report, printed and scanned, one order per page",
  "fuzzy_threshold": 80,
  "line_tolerance_ratio": 0.5,
  "value_max_gap_ratio": 3.0,
  "column_pad_ratio": 1.0,
  "low_confidence_threshold": 0.6,
  "header_fields": [
    {"field": "order_ref", "label": "Order #", "pattern": "^S\\d+$"},
    {"field": "order_date", "label": "Order Date", "kind": "datetime", "formats": ["%m/%d/%Y %H:%M:%S", "%m/%d/%Y"]},
    {"field": "salesperson", "label": "Salesperson"},
    {"field": "payment_terms", "label": "Mode of Payment"}
  ],
  "positional_fields": [
    {"field": "customer", "position": "first_line_of_block_above", "anchor_field": "order_ref", "block_max_gap_ratio": 1.0, "min_block_lines": 2}
  ],
  "table_columns": [
    {"field": "product", "label": "DESCRIPTION", "align": "left"},
    {"field": "quantity", "label": "QUANTITY", "align": "right", "starts_row": true},
    {"field": "unit_price", "label": "UNIT PRICE", "align": "right", "starts_row": true, "required": false},
    {"field": "taxes", "label": "TAXES", "align": "right", "required": false},
    {"field": "subtotal", "label": "AMOUNT", "align": "right", "starts_row": true}
  ],
  "totals": [
    {"field": "untaxed_total", "label": "Untaxed Amount", "required": false},
    {"field": "total", "label": "Total"}
  ],
  "pending_fields": {},
  "always_verify_fields": ["total", "untaxed_total", "subtotal", "unit_price", "order_date"]
}
